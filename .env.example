# Copier en .env. Sans clé, l'application démarre, dépose et extrait, mais la recherche,
# les légendes et les réponses échouent avec un message de panne.
OPENROUTER_API_KEY=

# Valeurs par défaut, à changer seulement si besoin.
# THOT_DATA_DIR=./data
# THOT_PORT=8000
# THOT_HOST=127.0.0.1
# THOT_SCHOOL_ID=pilote
# THOT_RETENTION_JOURS=90
# L'URL EU exige un compte OpenRouter avec routage régional activé.
# THOT_OPENROUTER_URL=https://eu.openrouter.ai/api/v1
# THOT_SEUIL_ABSTENTION=0.023
# THOT_MODELE_LEGENDE=google/gemma-4-26b-a4b-it
# THOT_MODELE_RECLASSEUR=qwen/qwen3-reranker-8b
# THOT_MODELE_GENERATION=deepseek/deepseek-v4.1-flash
# THOT_EFFORT_GENERATION=none
# Juge de soutien des citations. Avec une clé Mistral, il passe d'abord par l'API Mistral (UE),
# OpenRouter prend le relais en cas d'erreur, de 429 ou d'attente au-delà de 2,5 s.
# MISTRAL_API_KEY=
# THOT_MODELE_SOUTIEN_MISTRAL=zai-glm-5-3
# THOT_MODELE_SOUTIEN=z-ai/glm-5.3
