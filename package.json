{
  "name": "thot-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp build && node src/main.ts --watch",
    "start": "vp build && node src/main.ts",
    "thot": "node --env-file-if-exists=.env src/cli.ts",
    "test": "vp test run",
    "check": "vp check && vp build && pnpm frontiere && vp test run",
    "frontiere": "! grep -rnE \"from ['\\\"](\\\\.\\\\./)+app/\" src/core/",
    "board": "npx -y github:theopaolo/repoboard"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "snowball": "npm:snowball-stemmers@0.6.0"
  },
  "devDependencies": {
    "@std/assert": "jsr:^1.0.19",
    "@types/node": "^24.19.2",
    "vite-plus": "1.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.1",
      "onFail": "download"
    }
  }
}
